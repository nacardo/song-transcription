# Repo-root env file, used by docker-compose. Copy to .env and fill in.
#
# The backend also reads a backend/.env for `uv run` dev workflows — that
# file is separate and only used when running FastAPI outside Docker.

# Required: single-user login password. Set this to something unguessable.
APP_PASSWORD=change-me

# Required in prod: signing key for the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate-with-python-secrets-token_hex-32

# Set to true when the app is served behind HTTPS (production /
# Cloudflare Tunnel). Leave off for local http://localhost:8000 smoke tests
# — the browser won't send a Secure cookie back over http otherwise.
# SESSION_HTTPS_ONLY=true

# Baked into the JS bundle at docker build time (Vite substitutes VITE_*
# vars into the source). Get this from your Spotify Developer app dashboard.
VITE_SPOTIFY_CLIENT_ID=
