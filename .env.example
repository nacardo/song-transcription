# Repo-root env file. Copy to .env and fill in.
#
# Two flows read this file:
#   - Local dev on your Mac (docker-compose.yml) — needs APP_PASSWORD,
#     SESSION_SECRET, VITE_SPOTIFY_CLIENT_ID.
#   - Prod on Unraid (docker-compose.prod.yml) — needs APP_PASSWORD,
#     SESSION_SECRET, SESSION_HTTPS_ONLY, TUNNEL_TOKEN, GHCR_IMAGE.
#     VITE_SPOTIFY_CLIENT_ID is baked into the image at build time by the
#     GitHub Action (from a repo secret), so it's not needed here for prod.
#
# The backend also reads a backend/.env for `uv run` dev workflows — that
# file is separate and only used when running FastAPI outside Docker.

# Required everywhere: single-user login password. Something unguessable.
APP_PASSWORD=change-me

# Required everywhere: signing key for the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate-with-python-secrets-token_hex-32

# Set to true when the app is served behind HTTPS (prod / Cloudflare
# Tunnel). Leave off for local http://localhost:8080 smoke tests — the
# browser won't send a Secure cookie back over http otherwise.
# SESSION_HTTPS_ONLY=true

# Local dev only. Baked into the JS bundle at docker build time; in prod
# the GitHub Action injects the value from the VITE_SPOTIFY_CLIENT_ID repo
# secret. Get this from your Spotify Developer app dashboard.
VITE_SPOTIFY_CLIENT_ID=

# Prod on Unraid only. Cloudflare tunnel token (starts with `eyJ…`) that
# `cloudflared` uses to connect back to Cloudflare's edge.
# TUNNEL_TOKEN=

# Prod on Unraid only. Which container image the compose stack pulls.
# GHCR requires lowercase paths; use your GitHub username as-is but
# lowercased. `latest` is what Watchtower follows.
# GHCR_IMAGE=ghcr.io/<your-github-username-lowercase>/song-transcription:latest
